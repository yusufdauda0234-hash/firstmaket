APP_NAME=FirstMarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://firstmarket.localhost:8000

# Admin, Support, Logistics, and Finance dashboards are served from this
# subdomain with a session cookie scoped separately from the customer app
# (docs/firstmarket_Security_Compliance.md section 11.1). Map both hosts to
# 127.0.0.1 in your hosts file for local development.
ADMIN_DOMAIN=admin.firstmarket.localhost
VENDOR_DOMAIN=vendors.firstmarket.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

# First Super Administrator account, created by database/seeders/SuperAdministratorSeeder.php.
# Leave unset to skip seeding it; set before running `php artisan db:seed`.
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=

# mariadb locally (XAMPP); mysql for production MySQL 8
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=firstmarket
DB_USERNAME=root
DB_PASSWORD=

# Reporting/reconciliation connection — points at the same database until a
# read replica is provisioned (docs/firstmarket-Database_Schema.md).
DB_REPORTING_HOST=127.0.0.1
DB_REPORTING_PORT=3306
DB_REPORTING_USERNAME=root
DB_REPORTING_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database


# Email OTP + transactional mail go through Resend (resend.com) in prod;
# use "log" locally to write emails to storage/logs/laravel.log instead.
MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@firstmarket.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Resend API key from resend.com/api-keys. The MAIL_FROM_ADDRESS domain must
# be verified in Resend (or use onboarding@resend.dev while testing).
RESEND_KEY=

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_PUBLIC_BUCKET=
AWS_PUBLIC_URL=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paystack — never trust client-side payment success; wallet is credited
# only after a verified webhook (docs/firstmarket_Security_Compliance.md section 6).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

BVN_PROVIDER_DRIVER=paystack
BVN_PROVIDER_KEY=
BVN_PROVIDER_SECRET=

NIN_PROVIDER_DRIVER=youverify
NIN_PROVIDER_KEY=
NIN_PROVIDER_SECRET=
NIN_PROVIDER_BASE_URL=

# "log" writes SMS to the log for local development; set to "termii" (with a
# key) to send real messages.
SMS_PROVIDER_DRIVER=log
SMS_PROVIDER_KEY=
SMS_PROVIDER_SENDER_ID=FirstMkt
SMS_DAILY_BUDGET_KOBO=0

AI_PROVIDER_DRIVER=openai
AI_PROVIDER_KEY=
AI_MONTHLY_BUDGET_KOBO=0

ADDRESS_LOOKUP_KEY=

PUSH_NOTIFICATION_DRIVER=web_push
PUSH_NOTIFICATION_PUBLIC_KEY=
PUSH_NOTIFICATION_PRIVATE_KEY=

# Signs/verifies affiliate tracking tokens. Generate a dedicated random
# value — never reuse APP_KEY for this (docs/firstmarket_Security_Compliance.md section 10).
AFFILIATE_TRACKING_SIGNING_KEY=

CORS_ALLOWED_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

# Social login (Sprint 2 Addendum)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Support Center (Sprint 7)
SUPPORT_WHATSAPP_NUMBER=+2340000000000
SUPPORT_HOTLINE_NUMBER=+2340000000000
