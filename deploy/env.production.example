# FirstMaket — production .env template
#
# Copy to /var/www/firstmaket/.env on the server and fill in the blanks.
# Never commit the filled-in version: it holds the database password and the
# Paystack secret, and AppServiceProvider refuses to boot if APP_DEBUG is on
# precisely because the error page prints every value in this file.

APP_NAME=FirstMaket
APP_ENV=production

# Generate on the server with: php artisan key:generate
APP_KEY=

# false, always. The boot guard in AppServiceProvider will stop the app
# rather than let a stack trace publish these secrets.
APP_DEBUG=false

APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en

# https, not http. Every generated link — password resets, the Paystack
# callback, OAuth redirects — is built from this.
APP_URL=https://firstmaket.com

# The three portals are told apart by hostname; these must match the DNS
# records and the certificate exactly, or routing falls through to the
# customer site.
ADMIN_DOMAIN=admin.firstmaket.com
VENDOR_DOMAIN=vendors.firstmaket.com

# ── Database ────────────────────────────────────────────────────────────
# Azure Database for MySQL Flexible Server. Azure retired their MariaDB
# service, so this is `mysql`, not `mariadb`.
DB_CONNECTION=mysql
DB_HOST=<server-name>.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=firstmaket
DB_USERNAME=
DB_PASSWORD=

# Azure rejects unencrypted connections to MySQL. This bundle ships with the
# code and holds both roots Azure chains to, so a root rotation on their side
# does not take the site down.
#
# Leave it unset locally: config/database.php drops the option when empty,
# and a laptop's MariaDB presents no certificate to verify.
MYSQL_ATTR_SSL_CA=/home/site/wwwroot/ssl/azure-mysql-ca.pem

# ── Background work ─────────────────────────────────────────────────────
# `database`, not `sync`. On sync, every queued job runs inside the web
# request that triggered it — the shopper waits on the AI listing review and
# the vendor waits on an email send. Needs firstmaket-worker.service running.
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120

# The session cookie must be sent over HTTPS only, and cover the subdomains
# so a signed-in staff member is not logged out moving between portals.
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.firstmaket.com

CACHE_STORE=database

# The VM's own disk. It is a managed disk and persists across reboots and
# deploys — unlike App Service, where this would be wiped. Move to Azure Blob
# before running more than one VM, or before a VM resize.
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Payments ────────────────────────────────────────────────────────────
# TEST keys until you are genuinely launching. Live keys mean real cards are
# charged by a half-built checkout.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# Register this URL in the Paystack dashboard:
#   https://firstmaket.com/webhooks/paystack

# ── Mail and social sign-in ─────────────────────────────────────────────
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@firstmaket.com
MAIL_FROM_NAME=FirstMaket

# Update the redirect URIs in the Google and Facebook consoles too — they
# still point at localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://firstmaket.com/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://firstmaket.com/auth/facebook/callback
