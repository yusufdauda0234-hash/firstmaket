.agents/

# OS/editor noise
.DS_Store
Thumbs.db

# Laravel / Node artifacts for when the app is scaffolded
/vendor/
/node_modules/
/.env
/.env.*
!.env.example
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
/public/build/
/public/hot
/storage/*.key
/storage/pail

# User-uploaded documents (CAC files, etc.) on the private disk — never
# source, and may contain real personal data from local testing.
/storage/app/private/*
!/storage/app/private/.gitkeep
auth.json
.phpunit.result.cache
.phpunit.cache
Homestead.json
Homestead.yaml
/.fleet
/.idea
/.nova
/.vscode
/.zed
npm-debug.log
yarn-error.log


# Created by "artisan storage:link" at deploy time. Committed as a real
# directory it makes storage:link fail — --force only replaces an existing
# symlink, never a directory — so no link is made and every upload 404s.
/public/storage
